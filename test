// StoreEnseignantRequest.php
class StoreEnseignantRequest extends FormRequest
{
    public function authorize() { return true; }

    public function rules(): array
    {
        return [
            'nom'           => 'required|string|max:100',
            'prenom'        => 'required|string|max:100',
            'email'         => 'required|email|unique:enseignants,email',
            'telephone'     => 'nullable|string|max:20',
            'grade'         => 'required|in:Assistant,Maitre-Assistant,Professeur',
            'statut'        => 'required|in:Permanent,Vacataire',
            'taux_horaire'  => 'required|numeric|min:0',
            'id_departement'=> 'required|exists:departements,id_departement',
        ];
    }

    public function messages(): array
    {
        return [
            'email.unique'          => 'Cet email est déjà utilisé par un autre enseignant.',
            'id_departement.exists' => 'Le département sélectionné n\'existe pas.',
            'grade.in'              => 'Le grade doit être : Assistant, Maitre-Assistant ou Professeur.',
        ];
    }
}

// UpdateEnseignantRequest.php
class UpdateEnseignantRequest extends FormRequest
{
    public function authorize() { return true; }

    public function rules(): array
    {
        return [
            'nom'           => 'sometimes|string|max:100',
            'prenom'        => 'sometimes|string|max:100',
            'email'         => 'sometimes|email|unique:enseignants,email,' . $this->enseignant->id_enseignant . ',id_enseignant',
            'telephone'     => 'nullable|string|max:20',
            'grade'         => 'sometimes|in:Assistant,Maitre-Assistant,Professeur',
            'statut'        => 'sometimes|in:Permanent,Vacataire',
            'taux_horaire'  => 'sometimes|numeric|min:0',
            'id_departement'=> 'sometimes|exists:departements,id_departement',
        ];
    }
}

