class EnseignantResource extends JsonResource
{
    public function toArray($request): array
    {
        return [
            'id'           => $this->id_enseignant,
            'nom'          => $this->nom,
            'prenom'       => $this->prenom,
            'nom_complet'  => "{$this->prenom} {$this->nom}",
            'email'        => $this->email,
            'telephone'    => $this->telephone,
            'grade'        => $this->grade,
            'statut'       => $this->statut,
            'taux_horaire' => $this->taux_horaire,
            'actif'        => $this->actif,
            'departement'  => $this->whenLoaded('departement', fn() => [
                'id'  => $this->departement->id_departement,
                'nom' => $this->departement->nom_departement,
            ]),
            'created_at'   => $this->created_at->format('d/m/Y'),
        ];
    }
}

