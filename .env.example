# ══════════════════════════════════════════════════════════════════════════════
# PCT UVCI — Variables d'environnement Docker Compose
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS :
#   cp .env.example .env
#   Remplissez les valeurs marquées <OBLIGATOIRE>
#   Générez APP_KEY avec : docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# ══════════════════════════════════════════════════════════════════════════════

# ── Application Laravel ────────────────────────────────────────────────────────
# Générer avec la commande ci-dessus, ou après premier démarrage :
# docker exec pct-backend php artisan key:generate --show
APP_KEY=<OBLIGATOIRE — base64:...>

# ── Base de données MySQL ──────────────────────────────────────────────────────
DB_DATABASE=pct_db
DB_USERNAME=pct_user
DB_PASSWORD=pct_password
DB_ROOT_PASSWORD=root_secret

# ── Email (optionnel — laisser vide pour désactiver les emails) ───────────────
# Mode "log" : les emails sont écrits dans les logs Docker (recommandé en dev)
# Mode "smtp" : configurer Gmail App Password (voir README.md)
MAIL_MAILER=log
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=pct@uvci.edu.ci
MAIL_FROM_NAME="PCT UVCI"
