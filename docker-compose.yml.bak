services:

  # ── Frontend (Next.js) ──────────────────────────────────────────────────────
  frontend:
    build:
      context: ./PCT_frontend
      dockerfile: Dockerfile
    container_name: pct-frontend
    ports:
      - "3000:3000"
    environment:
      - NODE_ENV=production
    restart: unless-stopped

  # ── Backend (Laravel / PHP-FPM) ─────────────────────────────────────────────
  backend:
    build:
      context: ./PctBackend
      dockerfile: Dockerfile
    container_name: pct-backend
    volumes:
      - storage_data:/var/www/storage
    environment:
      APP_NAME: PCT
      APP_ENV: production
      APP_KEY: ${APP_KEY}
      APP_DEBUG: "false"
      APP_URL: http://localhost:8000
      DB_CONNECTION: mysql
      DB_HOST: db
      DB_PORT: 3306
      DB_DATABASE: ${DB_DATABASE:-pct_db}
      DB_USERNAME: ${DB_USERNAME:-pct_user}
      DB_PASSWORD: ${DB_PASSWORD:-pct_password}
      SESSION_DRIVER: database
      CACHE_STORE: database
      QUEUE_CONNECTION: database
      LOG_CHANNEL: stderr
      LOG_LEVEL: error
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  # ── Nginx (reverse proxy pour Laravel) ──────────────────────────────────────
  nginx:
    image: nginx:1.27-alpine
    container_name: pct-nginx
    ports:
      - "8000:80"
    volumes:
      - ./PctBackend/public:/var/www/public:ro
      - ./PctBackend/docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - backend
    restart: unless-stopped

  # ── Base de données (MySQL 8) ────────────────────────────────────────────────
  db:
    image: mysql:8.0
    container_name: pct-db
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:-pct_db}
      MYSQL_USER: ${DB_USERNAME:-pct_user}
      MYSQL_PASSWORD: ${DB_PASSWORD:-pct_password}
      MYSQL_ROOT_PASSWORD: ${DB_ROOT_PASSWORD:-root_secret}
    volumes:
      - db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${DB_ROOT_PASSWORD:-root_secret}"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped

volumes:
  db_data:
  storage_data: